# Space-awareness test: joint calibration (Hermes b = 2.4, 3.6, 5.0 m + CrowdQueue
# baseline w = 1.2, 3.4, 5.6 m, 30 sigma-normalised residuals) with a distance-based
# state rule (space_state.py): the per-agent parameters of CollisionFreeSpeedModelV2
# blend from the open-space value to f_<parameter> times it within d_switch (+- w_switch)
# of the gate line. Wall repulsion stays shared (no factor).
# Compare against joint/ (static set): Hermes norm 6.2, CrowdQueue norm 13.6.
# Bounds: see README.md (JuPedSim only enforces radius in (0, 2], time gap in [0.1, 10],
# desired speed in [0, 10]; the box below is the physically plausible part of that).
# Run: JPS_N_SEEDS=1 dakota -i dakota.in -o dakota.out
# Second start: change `seed`.

environment
  tabular_data
    tabular_data_file = 'sa_history.dat'

method
  efficient_global
    seed = 5
    max_iterations = 60
    convergence_tolerance = 1.e-4

variables
  continuous_design = 12
    descriptors    'radius' 'time_gap' 'strength_neighbor' 'range_neighbor' 'strength_geometry' 'range_geometry' 'd_switch' 'w_switch' 'f_radius' 'f_time_gap' 'f_strength_neighbor' 'f_range_neighbor'
    initial_point   0.115  0.96   8.6   0.19   4.7   0.03   1.5   0.5   1.00  0.80  1.0   0.7
    lower_bounds    0.10   0.30   1.0   0.02   1.0   0.01   0.3   0.1   0.60  0.35  0.2   0.2
    upper_bounds    0.22   1.50  10.0   0.35  10.0   0.15   4.0   1.5   1.00  1.50  3.0   1.2
  continuous_state = 1
    descriptors    'desired_speed'
    initial_state   1.55

interface
  fork
    analysis_drivers = 'python3 driver_sa.py'
    parameters_file  = 'params.in'
    results_file     = 'results.out'
    work_directory named 'runs/run' directory_tag
    link_files = 'driver_sa.py' '../space_state.py' '../hermes/driver.py' '../hermes/observables.py' '../hermes/scenario.py' '../hermes/exp_observables.json' '../crowdqueue/driver_cq.py' '../crowdqueue/observables_cq.py' '../crowdqueue/scenario_cq.py' '../crowdqueue/exp_observables_cq.json'
  asynchronous evaluation_concurrency = 1

responses
  calibration_terms = 30
  no_gradients
  no_hessians
