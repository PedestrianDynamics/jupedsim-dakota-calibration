# Two-parameter profile/refit on h0 with the five static parameters fixed at set C.
# Reproduce: CQ_RESIDUALS=1 CQ_RUNS=030_c_56_h0,050_c_45_h0,070_c_23_h0,090_c_12_h0,110_c_12_h0,150_q_56_h0,170_q_12_h0,190_q_34_h0,230_q_23_h0,250_q_45_h0,270_c_34_h0 JPS_N_SEEDS=1 JPS_WORKERS=3 dakota -i dakota.in -o dakota.out

environment
  tabular_data
    tabular_data_file = 'motivation_profile_history.dat'

method
  efficient_global
    seed = 11
    max_iterations = 20
    convergence_tolerance = 1.e-4

variables
  continuous_design = 2
    descriptors  'desired_speed' 'time_gap'
    initial_point  1.55 1.038
    lower_bounds   0.80 0.10
    upper_bounds   1.80 2.00

interface
  fork
    analysis_drivers = 'python3 driver_cq_set_c.py'
    parameters_file = 'params.in'
    results_file = 'results.out'
    work_directory named 'runs/run' directory_tag
    link_files = '../driver_cq.py' '../driver_cq_set_c.py' '../parameter_io.py' '../observables_cq.py' '../scenario_cq.py' '../exp_observables_cq.json'
  asynchronous evaluation_concurrency = 1

responses
  calibration_terms = 33
  no_gradients
  no_hessians
